# CallMissed API Key (Required for Voice Agent WebRTC sessions, also supports Chat & Image)
CALLMISSED_API_KEY=

# Optional dedicated LLM API Key (if using direct OpenAI/Anthropic/custom provider instead of CallMissed)
LLM_API_KEY=

# Optional dedicated Image Generation API Key (if using direct OpenAI DALL-E instead of CallMissed)
IMAGE_API_KEY=

# Optional custom base URL for OpenAI-compatible LLM endpoint (defaults to https://api.callmissed.com/v1)
LLM_BASE_URL=
